#!/usr/bin/env python3
"""alg-rgb — keyboard backlight driver for Acer ALG (CLV0001 ACPI).

The ALG keyboard is NOT a USB HID device.  It is exposed through the
undocumented CLV0001 ACPI device (Linux path ``\\_SB.DCHU``) and is driven
by a small kernel module that creates ``/dev/alg_rgb`` (see
github.com/24kaushik/alg-cli).  The module validates colours and sends a
``_DSM()`` packet to the firmware:

    UUID      93f224e4-fbdc-4bbf-add6-db71bdc0afad
    Function  0x67
    Payload   [Green, Red, Blue, 0xF0]   (note the GRB ordering!)

This script is a thin userspace wrapper: it validates arguments and writes
``<color> <brightness>`` to ``/dev/alg_rgb``.  Only the known-safe 0x67
command is ever issued; the undocumented 0x68/0x69/0x6A functions are
intentionally never used (one experimental call hard-locked the machine).

Usage
-----
    alg-rgb <color> [brightness]

``<color>`` is one of: off, red, orange, yellow, lime, light-green, green,
green-cyan, cyan, light-blue, blue, violet, magenta, pink, flesh,
bluish-white, white.
``<brightness>`` is an integer from 0 (off) to 4 (maximum), default 4.

If the module is missing a clear error is printed and the tool exits with
code 1 — the Control Center handles this gracefully and shows "RGB driver
not installed."
"""

from __future__ import annotations

import sys
from typing import List

#: Colours understood by the kernel module (firmware GRB table).
COLORS: List[str] = [
    "off", "red", "orange", "yellow", "lime", "light-green", "green",
    "green-cyan", "cyan", "light-blue", "blue", "violet", "magenta",
    "pink", "flesh", "bluish-white", "white",
]

DEVICE: str = "/dev/alg_rgb"
VERSION: str = "0.1.3"

USAGE: str = (
    "Usage: alg-rgb <color> [brightness]\n"
    "  colors: " + ", ".join(COLORS) + "\n"
    "  brightness: 0 (off) to 4 (maximum), default 4\n"
)


def main(argv: List[str]) -> int:
    """CLI entry point.

    Parameters
    ----------
    argv : List[str]
        Full argument list including the program name.

    Returns
    -------
    int
        Process exit code.
    """
    args = argv[1:]
    if args and args[0] in ("-h", "--help"):
        print(USAGE, end="")
        return 0
    if args and args[0] == "--version":
        print(f"alg-rgb {VERSION}")
        return 0
    if not args:
        print(USAGE, end="", file=sys.stderr)
        return 2

    color = args[0]
    if color not in COLORS:
        print(f"error: unknown color '{color}'", file=sys.stderr)
        print("valid colors: " + ", ".join(COLORS), file=sys.stderr)
        return 2

    brightness = 4
    if len(args) > 1:
        try:
            brightness = int(args[1])
        except ValueError:
            print(f"error: brightness must be an integer, got '{args[1]}'",
                  file=sys.stderr)
            return 2
        if not 0 <= brightness <= 4:
            print("error: brightness must be between 0 and 4", file=sys.stderr)
            return 2

    try:
        with open(DEVICE, "w", encoding="ascii") as device:
            device.write(f"{color} {brightness}\n")
    except FileNotFoundError:
        print("error: the alg_rgb kernel module is not loaded.", file=sys.stderr)
        print("install it from https://github.com/24kaushik/alg-cli "
              "or run: sudo modprobe alg_rgb", file=sys.stderr)
        return 1
    except PermissionError:
        print("error: permission denied writing to /dev/alg_rgb.",
              file=sys.stderr)
        print("give your user access with: "
              "sudo usermod -aG alg-rgb $USER", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    print(f"Set keyboard to {color} at brightness {brightness}.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
